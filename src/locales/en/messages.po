#. Shown when a mocked or network request times out
#. js-lingui-explicit-id
#: src/i18n/error-keys.ts
msgid "errors.networkTimeout"
msgstr "The request took too long. Try again."

#. js-lingui-explicit-id
#: src/screens/activity-detail/messages.ts
msgid "activityDetail.unavailableBody"
msgstr "This activity link is invalid or the activity is no longer available."

#. Shown when an activity id is missing from the catalog
#. js-lingui-explicit-id
#: src/i18n/error-keys.ts
