{
  "name": "explora-agile-monkeys",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "format": "oxfmt .",
    "lint": "oxlint . --deny-warnings",
    "fix": "oxlint . --fix --deny-warnings && oxfmt .",
    "lingui:extract": "lingui extract --clean",
    "i18n:check": "lingui extract --clean && git diff --exit-code -- src/locales",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "prepare": "husky",
    "postinstall": "patch-package",
    "build:ios:dev:simulator": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=dist/eas-builds npx eas-cli build --platform ios --profile development-simulator --local --non-interactive",
    "build:ios:dev:device": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=dist/eas-builds npx eas-cli build --platform ios --profile development --local",
    "build:android:dev:emulator": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=dist/eas-builds npx eas-cli build --platform android --profile development --local --non-interactive",
    "build:android:dev:device": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=dist/eas-builds npx eas-cli build --platform android --profile development --local --non-interactive",
    "build:ios:prod:simulator": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=dist/eas-builds npx eas-cli build --platform ios --profile production-simulator --local --non-interactive",
    "build:ios:prod:device": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=dist/eas-builds npx eas-cli build --platform ios --profile production --local",
    "build:android:prod:emulator": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=dist/eas-builds npx eas-cli build --platform android --profile production-simulator --local --non-interactive",
    "build:android:prod:device": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=dist/eas-builds npx eas-cli build --platform android --profile production-apk --local --non-interactive",
    "build:android:prod:store": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=dist/eas-builds npx eas-cli build --platform android --profile production --local"
  },
  "dependencies": {
    "@bsky.app/expo-scroll-edge-effect": "^0.1.10",
    "@expo/ui": "~58.0.6",
    "@faker-js/faker": "^10.6.0",
    "@formatjs/intl-locale": "^5.3.11",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@legendapp/list": "^3.4.0",
    "@legendapp/state": "^3.0.0-beta.48",
    "@lingui/core": "^6.7.0",
    "@lingui/react": "^6.7.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native/js-polyfills": "^0.88.0-rc.1",
    "@rnrepo/expo-config-plugin": "^0.3.6",
    "@shopify/react-native-skia": "2.11.2",
    "@tanstack/react-query": "^5.103.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "expo": "~58.0.0-preview.6",
    "expo-application": "~58.0.1",
    "expo-asset": "~58.0.4",
    "expo-blur": "~58.0.1",
    "expo-build-properties": "~58.0.6",
    "expo-calendar": "~58.0.2",
    "expo-constants": "~58.0.4",
    "expo-dev-client": "~58.0.6",
    "expo-device": "~58.0.2",
    "expo-font": "~58.0.2",
    "expo-glass-effect": "~58.0.2",
    "expo-image": "~58.0.5",
    "expo-linear-gradient": "~58.0.1",
    "expo-linking": "~58.0.6",
    "expo-localization": "~58.0.1",
    "expo-network": "~58.0.1",
    "expo-router": "~58.0.7",
    "expo-sharing": "~58.0.9",
    "expo-splash-screen": "~58.0.1",
    "expo-status-bar": "~58.0.1",
    "expo-symbols": "~58.0.2",
    "expo-system-ui": "~58.0.2",
    "expo-web-browser": "~58.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.3",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-native": "0.88.0-rc.1",
    "react-native-a11y": "0.9.0",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-keyboard-controller": "1.22.4",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-pulsar": "^1.7.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.12.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@lingui/babel-plugin-lingui-macro": "^6.7.0",
    "@lingui/cli": "^6.7.0",
    "@lingui/format-po": "^6.7.0",
    "@lingui/metro-transformer": "^6.7.0",
    "@react-native/jest-preset": "0.88.0-rc.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "~19.3.0",
    "eslint-plugin-lingui": "^0.16.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "husky": "^9.1.7",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-plugin-react-native": "^0.2.35",
    "oxlint-tsgolint": "^7.0.2002",
    "patch-package": "^8.0.1",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
